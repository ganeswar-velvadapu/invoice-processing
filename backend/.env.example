# --- required ---
# Neon connection string. Use the *direct* (non "-pooler") host: migrations take a session advisory lock.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/invoiceproc?sslmode=require
# 32+ random characters, e.g. `openssl rand -hex 32`
JWT_SECRET=
# Bootstrap admin, created only when the users table is empty.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# --- optional ---
# Our own GSTIN(s): helps tell buyer from seller and flags invoices billed to someone else.
BUYER_GSTINS=
STORAGE_DIR=../data/storage
LISTEN_ADDR=:8080
CORS_ORIGINS=http://localhost:3000
JWT_TTL=12h
MAX_UPLOAD_MB=50

# GSTIN checksum policy: strict (default, real data) | warn (mismatch -> review) | off (format only; synthetic data)
GSTIN_CHECKSUM=strict

# --- Local vision model (optional, scripts/setup_vlm.sh) ---
# OLLAMA_VERSION=0.40.11
# OLLAMA_CPUS=6
# OLLAMA_MEM_LIMIT=7g
# VLM_MODEL=qwen3-vl:4b-instruct

# --- Vision model (scans, handwriting, and PDFs the rules are unsure about) ---
OLLAMA_URL=http://ollama:11434
VLM_MODEL=qwen3-vl:4b-instruct
VLM_PAGE_TIMEOUT=10m
VLM_MAX_PX=1600

# --- Which vision model reads scans: local (private) or cloud ---
# local: Qwen3-VL through Ollama (settings above); documents never leave this machine.
# cloud: any OpenAI-compatible API (Gemini, OpenAI, OpenRouter...); scanned pages are SENT to the provider.
#        Gemini key: https://aistudio.google.com/apikey  (free tier: ~15 requests/min, ~500/day)
VLM_PROVIDER=local
# LLM_API_KEY=
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# --- Email ingestion (optional) ---
# The app checks this mailbox for unread mail and processes PDF / image attachments like uploads.
# Gmail: turn on 2-Step Verification, create an App password (Google Account > Security > App passwords)
# and paste it below (spaces are fine). Leave IMAP_HOST empty to switch email ingestion off.
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=your.ap.mailbox@gmail.com
# IMAP_PASSWORD=abcd efgh ijkl mnop
# IMAP_FOLDER=INBOX
# IMAP_POLL_INTERVAL=60s
